{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://german-exercises-app.local/schemas/exercise-import.schema.json",
  "title": "German Exercises Import",
  "description": "Schema for importing German language exercises",
  "type": "object",
  "additionalProperties": false,

  "required": ["version", "language", "exercises"],

  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },

    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 20
    },

    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    }
  },

  "$defs": {
    "exercise": {
      "type": "object",
      "additionalProperties": false,

      "required": ["title", "type", "level", "topics", "data"],

      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },

        "type": {
          "type": "string",
          "enum": [
            "vocabulary_drill",
            "multiple_choice",
            "dropdown",
            "gap_fill",
            "sentence_builder"
          ]
        },

        "level": {
          "type": "string",
          "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
        },

        "topics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "uniqueItems": true
        },

        "active": {
          "type": "boolean",
          "default": true
        },

        "order": {
          "type": "integer",
          "minimum": 0
        },

        "data": {
          "oneOf": [
            {
              "$ref": "#/$defs/vocabularyDrill"
            },
            {
              "$ref": "#/$defs/multipleChoice"
            },
            {
              "$ref": "#/$defs/dropdown"
            },
            {
              "$ref": "#/$defs/gapFill"
            },
            {
              "$ref": "#/$defs/sentenceBuilder"
            }
          ]
        }
      },

      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "vocabulary_drill"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/vocabularyDrill"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "multiple_choice"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/multipleChoice"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dropdown"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/dropdown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gap_fill"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/gapFill"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "sentence_builder"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/sentenceBuilder"
              }
            }
          }
        }
      ]
    },

    "vocabularyDrill": {
      "type": "object",
      "additionalProperties": false,

      "required": ["items"],

      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "additionalProperties": false,

            "required": ["word", "correct", "distractors"],

            "properties": {
              "word": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },

              "correct": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },

              "distractors": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            }
          }
        }
      }
    },

    "multipleChoice": {
      "type": "object",
      "additionalProperties": false,

      "required": ["items"],

      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "additionalProperties": false,

            "required": ["question", "selection_mode", "options"],

            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },

              "selection_mode": {
                "type": "string",
                "enum": ["single", "multiple"]
              },

              "options": {
                "type": "array",
                "minItems": 2,

                "items": {
                  "$ref": "#/$defs/choiceOption"
                }
              }
            }
          }
        }
      }
    },

    "choiceOption": {
      "type": "object",
      "additionalProperties": false,

      "required": ["text", "correct"],

      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },

        "correct": {
          "type": "boolean"
        }
      }
    },

    "dropdown": {
      "type": "object",
      "additionalProperties": false,

      "required": ["items"],

      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "additionalProperties": false,

            "required": ["parts"],

            "properties": {
              "parts": {
                "type": "array",
                "minItems": 1,

                "items": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/textPart"
                    },
                    {
                      "$ref": "#/$defs/selectPart"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },

    "textPart": {
      "type": "object",
      "additionalProperties": false,

      "required": ["type", "text"],

      "properties": {
        "type": {
          "const": "text"
        },

        "text": {
          "type": "string"
        }
      }
    },

    "selectPart": {
      "type": "object",
      "additionalProperties": false,

      "required": ["type", "options"],

      "properties": {
        "type": {
          "const": "select"
        },

        "options": {
          "type": "array",
          "minItems": 2,

          "items": {
            "$ref": "#/$defs/choiceOption"
          }
        }
      }
    },

    "gapFill": {
      "type": "object",
      "additionalProperties": false,

      "required": ["items"],

      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "additionalProperties": false,

            "required": ["text", "gaps"],

            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },

              "gaps": {
                "type": "array",
                "minItems": 1,

                "items": {
                  "$ref": "#/$defs/gap"
                }
              }
            }
          }
        }
      }
    },

    "gap": {
      "type": "object",
      "additionalProperties": false,

      "required": ["placeholder", "correct"],

      "properties": {
        "placeholder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },

        "correct": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },

    "sentenceBuilder": {
      "type": "object",
      "additionalProperties": false,

      "required": ["items"],

      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",
            "additionalProperties": false,

            "required": ["tokens"],

            "properties": {
              "tokens": {
                "type": "array",
                "minItems": 2,

                "items": {
                  "$ref": "#/$defs/sentenceToken"
                }
              }
            }
          }
        }
      }
    },

    "sentenceToken": {
      "type": "object",
      "additionalProperties": false,

      "required": ["text", "position"],

      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },

        "position": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}